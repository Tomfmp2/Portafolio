# Contact form (app/api/contact/route.ts). Copy to .env.local for local runs and
# set the same variables in Vercel → Project → Settings → Environment Variables.

# Gmail account that sends the messages.
GMAIL_USER=
# A Google app password for that account (myaccount.google.com/apppasswords), not its normal password.
GMAIL_APP_PASSWORD=
# Who receives them, comma-separated.
CONTACT_TO=
